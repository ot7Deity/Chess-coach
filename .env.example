# Copy to .env and fill in. .env is gitignored: this repo is public.

# --- Database / cache -------------------------------------------------------
DATABASE_URL=postgresql+psycopg://chess:chess@localhost:5432/chess_coach
REDIS_URL=redis://localhost:6379/0

# --- Chess.com client -------------------------------------------------------
# Chess.com asks API clients to identify themselves with contact info. This is
# sent in the User-Agent on every request, so keep the real value in .env only.
CHESSCOM_CONTACT=you@example.com

# Requests per second across ALL ingest workers combined (token bucket in Redis).
CHESSCOM_RATE_PER_SEC=1.0
CHESSCOM_BURST=3
# Retries after the first attempt on 429 / 5xx / network errors, with
# exponential backoff (base doubling per attempt, capped) plus jitter.
CHESSCOM_MAX_RETRIES=5
CHESSCOM_BACKOFF_BASE_SEC=1.0
CHESSCOM_BACKOFF_CAP_SEC=60.0

# --- Engine -----------------------------------------------------------------
# Populated by: uv run python tools/fetch_stockfish.py
STOCKFISH_PATH=vendor/stockfish/stockfish.exe
# Fixed search depth. Must be fixed (not movetime) so evaluations are
# reproducible and therefore cacheable. Lower it for fast local iteration.
ENGINE_DEPTH=16
ENGINE_THREADS=1
ENGINE_HASH_MB=128
# Seconds before a single position evaluation is treated as a hung engine.
ENGINE_TIMEOUT_SEC=30

# --- Position cache / metrics -----------------------------------------------
# full = Redis in front of Postgres; postgres = Postgres only; off = no cache
# (every position goes to Stockfish - the benchmark's "without cache" baseline).
POSITION_CACHE=full
# Redis keys are <prefix><database>:<epoch>:<engine_version>:<depth>:<sha256 hex>,
# the epoch being the positions table's relfilenode (new on TRUNCATE/restore), so
# Redis never answers for rows Postgres no longer has, and databases sharing a
# Redis db stay apart. Changing the version segment orphans every Redis entry;
# Postgres is the source of truth.
POSITION_CACHE_KEY_PREFIX=chess_coach:pos:v1:
# Sliding expiry, refreshed on every hit, so hot opening positions stay in
# Redis and one-off middlegame positions age out. 0 = never expire.
POSITION_CACHE_TTL_SEC=604800
# Per-command Redis timeout, and how long to stay Postgres-only after a Redis
# failure before trying Redis again.
POSITION_CACHE_REDIS_TIMEOUT_SEC=0.25
POSITION_CACHE_REDIS_RETRY_SEC=30
# Prometheus /metrics endpoint per worker process. 0 = disabled. Workers on one
# host listen on METRICS_PORT + worker index. Use 0.0.0.0 inside containers.
METRICS_PORT=0
METRICS_ADDR=127.0.0.1

# --- Workers ----------------------------------------------------------------
WORKER_POLL_INTERVAL_SEC=1.0
JOB_MAX_ATTEMPTS=5
JOB_LOCK_TIMEOUT_SEC=300

# --- Misc -------------------------------------------------------------------
LOG_LEVEL=INFO
ENV=dev
