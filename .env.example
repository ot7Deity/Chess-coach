# Copy to .env and fill in. .env is gitignored: this repo is public.

# --- Database / cache -------------------------------------------------------
DATABASE_URL=postgresql+psycopg://chess:chess@localhost:5432/chess_coach
REDIS_URL=redis://localhost:6379/0

# --- Chess.com client -------------------------------------------------------
# Chess.com asks API clients to identify themselves with contact info. This is
# sent in the User-Agent on every request, so keep the real value in .env only.
CHESSCOM_CONTACT=you@example.com

# Requests per second across ALL ingest workers combined (token bucket in Redis).
CHESSCOM_RATE_PER_SEC=1.0
CHESSCOM_BURST=3
# Retries after the first attempt on 429 / 5xx / network errors, with
# exponential backoff (base doubling per attempt, capped) plus jitter.
CHESSCOM_MAX_RETRIES=5
CHESSCOM_BACKOFF_BASE_SEC=1.0
CHESSCOM_BACKOFF_CAP_SEC=60.0

# --- Engine -----------------------------------------------------------------
# Populated by: uv run python tools/fetch_stockfish.py
STOCKFISH_PATH=vendor/stockfish/stockfish.exe
# Fixed search depth. Must be fixed (not movetime) so evaluations are
# reproducible and therefore cacheable. Lower it for fast local iteration.
ENGINE_DEPTH=16
# Must be 1 (enforced). More search threads make Stockfish non-deterministic,
# and a result that changes run to run cannot be cached. Scale with workers.
ENGINE_THREADS=1
# Part of the cache's engine version ('sf_18-h128'): changing it changes some
# evaluations slightly, so it starts a fresh set of cached positions.
ENGINE_HASH_MB=128
# Seconds before a single position evaluation is treated as a hung engine. The
# engine is killed and restarted and the job is retried.
ENGINE_TIMEOUT_SEC=30

# --- Workers ----------------------------------------------------------------
WORKER_POLL_INTERVAL_SEC=1.0
# Attempts before a job is dead-lettered (status 'dead').
JOB_MAX_ATTEMPTS=5
# A running job whose worker has not heartbeated for this long is handed back
# to the queue. Workers heartbeat every third of this while they work.
JOB_LOCK_TIMEOUT_SEC=300
# Retry backoff after a failed attempt: base * 2^(attempt-1), capped, jittered.
JOB_RETRY_BASE_SEC=30
JOB_RETRY_CAP_SEC=1800

# --- Misc -------------------------------------------------------------------
LOG_LEVEL=INFO
ENV=dev
