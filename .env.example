# Copy to .env and fill in. .env is gitignored: this repo is public.

# --- Database / cache -------------------------------------------------------
DATABASE_URL=postgresql+psycopg://chess:chess@localhost:5432/chess_coach
REDIS_URL=redis://localhost:6379/0

# --- Chess.com client -------------------------------------------------------
# Chess.com asks API clients to identify themselves with contact info. This is
# sent in the User-Agent on every request, so keep the real value in .env only.
CHESSCOM_CONTACT=you@example.com

# Requests per second across ALL ingest workers combined (token bucket in Redis).
CHESSCOM_RATE_PER_SEC=1.0
CHESSCOM_BURST=3

# --- Engine -----------------------------------------------------------------
# Populated by: uv run python tools/fetch_stockfish.py
STOCKFISH_PATH=vendor/stockfish/stockfish.exe
# Fixed search depth. Must be fixed (not movetime) so evaluations are
# reproducible and therefore cacheable. Lower it for fast local iteration.
ENGINE_DEPTH=16
ENGINE_THREADS=1
ENGINE_HASH_MB=128
# Seconds before a single position evaluation is treated as a hung engine.
ENGINE_TIMEOUT_SEC=30

# --- Workers ----------------------------------------------------------------
WORKER_POLL_INTERVAL_SEC=1.0
JOB_MAX_ATTEMPTS=5
JOB_LOCK_TIMEOUT_SEC=300

# --- Misc -------------------------------------------------------------------
LOG_LEVEL=INFO
ENV=dev
